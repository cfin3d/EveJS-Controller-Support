        "description": "Use a key, mouse button, chord such as CTRL+SPACE, or tap:F1. Empty means unassigned. See README for supported names."
      },
      {
        "id": "binding-dpad_up",
        "label": "DPAD_UP binding",
        "type": "string",
        "default": "SCROLL_UP",
        "maxLength": 128,
        "file": "preferences",
        "key": [
          "bindings",
