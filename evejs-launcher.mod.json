{
  "schemaVersion": 3,
  "id": "evejs-controller",
  "displayName": "EveJS Controller",
  "version": "0.1.0",
  "description": "Legion Go and Xbox controller support with analog cursor precision, gentle UI attraction, circular hold feedback, LB right-click, RB left-click, right-stick camera panning, camera-center flight on short press, and stop on a one-second hold. Starts automatically at EveJS login.",
  "kind": "loader",
  "supportedBackends": [
    "native",
    "docker"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.9"
    ]
  },
  "loadBefore": [
    "automining"
  ],
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.53",
    "helper": {
      "runtime": "executable",
      "path": "EveJSController.exe"
    },
    "capabilities": [
      "install",
      "prepare_profile",
      "prepare_disable",
      "prepare_remove",
      "recover"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "preferences.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "controllerIndex",
        "label": "Controller",
        "type": "choice",
        "default": -1,
        "file": "preferences",
        "key": [
          "controllerIndex"
        ],
        "restart": "none",
        "group": "Controller feel",
        "choices": [
          {
            "value": -1,
            "label": "Auto-detect"
          },
          {
            "value": 0,
            "label": "XInput slot 0"
          },
          {
            "value": 1,
            "label": "XInput slot 1"
          },
          {
            "value": 2,
            "label": "XInput slot 2"
          },
          {
            "value": 3,
            "label": "XInput slot 3"
          }
        ]
      },
      {
        "id": "deadzone",
        "label": "Stick deadzone",
        "type": "number",
        "default": 0.2,
        "file": "preferences",
        "key": [
          "deadzone"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 0.05,
        "maximum": 0.5,
        "step": 0.01,
        "description": "A radial deadzone suppresses drift. Small left-stick movements above this point give precision control."
      },
      {
        "id": "cursorSpeed",
        "label": "Maximum cursor speed (pixels/second)",
        "type": "integer",
        "default": 1100,
        "file": "preferences",
        "key": [
          "cursorSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50
      },
      {
        "id": "cameraSpeed",
        "label": "Maximum camera drag speed (pixels/second)",
        "type": "integer",
        "default": 800,
        "file": "preferences",
        "key": [
          "cameraSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50
      },
      {
        "id": "cameraButton",
        "label": "Camera drag mouse button",
        "type": "choice",
        "default": "MOUSE_LEFT",
        "file": "preferences",
        "key": [
          "cameraButton"
        ],
        "restart": "none",
        "group": "Controller feel",
        "choices": [
          {
            "value": "MOUSE_LEFT",
            "label": "Left button (rotate)"
          },
          {
            "value": "MOUSE_RIGHT",
            "label": "Right button"
          },
          {
            "value": "MOUSE_MIDDLE",
            "label": "Middle button"
          }
        ],
        "description": "Uses the client's normal camera drag behavior. Place the anchor in clear space."
      },
      {
        "id": "cameraAnchorX",
        "label": "Camera anchor across window (fraction)",
        "type": "number",
        "default": 0.5,
        "file": "preferences",
        "key": [
          "cameraAnchorX"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 0.05,
        "maximum": 0.95,
        "step": 0.01,
        "advanced": true
      },
      {
        "id": "cameraAnchorY",
        "label": "Camera anchor down window (fraction)",
        "type": "number",
        "default": 0.4,
        "file": "preferences",
        "key": [
          "cameraAnchorY"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 0.05,
        "maximum": 0.95,
        "step": 0.01,
        "advanced": true
      },
      {
        "id": "scrollSpeed",
        "label": "D-pad scroll speed (notches/second)",
        "type": "number",
        "default": 6,
        "file": "preferences",
        "key": [
          "scrollSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 0.5,
        "maximum": 30,
        "step": 0.5
      },
      {
        "id": "triggerThreshold",
        "label": "Trigger threshold for optional bindings",
        "type": "integer",
        "default": 40,
        "file": "preferences",
        "key": [
          "triggerThreshold"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 10,
        "maximum": 250,
        "step": 1,
        "advanced": true,
        "description": "LT and RT are unassigned by default. This applies only if you bind them yourself."
      },
      {
        "id": "cursorRing",
        "label": "Circular controller cursor",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorRing"
        ],
        "restart": "none",
        "group": "Controller feel",
        "description": "A minimal circular cursor with animated attraction and hold-to-click feedback."
      },
      {
        "id": "cursorSnap",
        "label": "Gentle attraction to UI targets",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorSnap"
        ],
        "restart": "none",
        "group": "Controller feel",
        "description": "Pulls toward the center of a nearby hovered EVE control while moving the cursor slowly. Strong stick movement escapes it. Does not snap in empty space or during drags."
      },
      {
        "id": "snapRadius",
        "label": "Attraction radius (pixels)",
        "type": "integer",
        "default": 28,
        "file": "preferences",
        "key": [
          "snapRadius"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 8,
        "maximum": 64,
        "step": 1,
        "advanced": true
      },
      {
        "id": "snapMaxSpeed",
        "label": "Maximum speed for attraction (pixels/second)",
        "type": "integer",
        "default": 250,
        "file": "preferences",
        "key": [
          "snapMaxSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 50,
        "maximum": 600,
        "step": 10,
        "advanced": true
      },
      {
        "id": "clickHoldMilliseconds",
        "label": "Hold-to-click time (milliseconds)",
        "type": "integer",
        "default": 500,
        "file": "preferences",
        "key": [
          "clickHoldMilliseconds"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 200,
        "maximum": 2000,
        "step": 50,
        "description": "Every controller mouse click waits for this hold. Default 500 ms. Release early to cancel; keep holding after confirmation to drag."
      },
      {
        "id": "rightStickStopMilliseconds",
        "label": "Right-stick stop hold (milliseconds)",
        "type": "integer",
        "default": 1000,
        "file": "preferences",
        "key": [
          "rightStickStopMilliseconds"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 500,
        "maximum": 3000,
        "step": 100,
        "description": "Default 1000 ms. Release a shorter right-stick press to fly toward camera center. Hold this long to stop without issuing forward flight."
      },
      {
        "id": "binding-lb",
        "label": "LB binding",
        "type": "string",
        "default": "MOUSE_RIGHT",
        "maxLength": 128,
        "file": "preferences",
        "key": [
          "bindings",
          "LB"
        ],
        "group": "Button bindings",
        "restart": "none",
        "description": "Use a key, mouse button, chord such as CTRL+SPACE, or tap:F1. Empty means unassigned. See README for supported names."
      },
      {
        "id": "binding-rb",
        "label": "RB binding",
        "type": "string",
        "default": "MOUSE_LEFT",
        "maxLength": 128,
        "file": "preferences",
        "key": [
          "bindings",
          "RB"
        ],
        "group": "Button bindings",
        "restart": "none",
        "description": "Use a key, mouse button, chord such as CTRL+SPACE, or tap:F1. Empty means unassigned. See README for supported names."
      },
      {
        "id": "binding-lt",
        "label": "LT binding",
        "type": "string",
        "default": "",
        "maxLength": 128,
        "file": "preferences",
        "key": [
          "bindings",
