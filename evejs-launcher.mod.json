{
  "schemaVersion": 3,
  "id": "evejs-controller",
  "displayName": "EveJS Controller",
  "version": "0.1.0",
  "description": "Controller support inside the EVE client with automatic controller and mouse/keyboard switching, analog cursor precision, hold-to-click, camera panning and camera-center ship navigation.",
  "kind": "loader",
  "supportedBackends": [
    "native",
    "docker"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.9"
    ]
  },
  "loadBefore": [
    "automining"
  ],
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.53",
    "helper": {
      "runtime": "powershell",
      "path": "launcher-helper.ps1"
    },
    "capabilities": [
      "install",
      "prepare_profile",
      "prepare_disable",
      "prepare_remove",
      "recover"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "preferences.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "controllerIndex",
        "label": "Controller",
        "type": "choice",
        "default": -1,
        "file": "preferences",
        "key": [
          "controllerIndex"
        ],
        "restart": "none",
        "group": "Controller feel",
        "choices": [
          {
            "value": -1,
            "label": "Auto-detect"
          },
          {
            "value": 0,
            "label": "XInput slot 0"
          },
          {
            "value": 1,
            "label": "XInput slot 1"
          },
          {
            "value": 2,
            "label": "XInput slot 2"
          },
          {
            "value": 3,
            "label": "XInput slot 3"
          }
        ]
      },
      {
        "id": "deadzone",
        "label": "Stick deadzone",
        "type": "number",
        "default": 0.2,
        "file": "preferences",
        "key": [
          "deadzone"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 0.05,
        "maximum": 0.5,
        "step": 0.01,
        "description": "A radial deadzone suppresses drift. Small left-stick movements above this point give precision control."
      },
      {
        "id": "cursorSpeed",
        "label": "Maximum cursor speed (pixels/second)",
        "type": "integer",
        "default": 1100,
        "file": "preferences",
        "key": [
          "cursorSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50
      },
      {
        "id": "cameraSpeed",
        "label": "Camera movement speed",
        "type": "integer",
        "default": 800,
        "file": "preferences",
        "key": [
          "cameraSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50
      },
      {
        "id": "cursorRing",
        "label": "Circular controller cursor",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorRing"
        ],
        "restart": "none",
        "group": "Controller feel",
        "description": "A minimal circular cursor with animated attraction and hold-to-click feedback."
      },
      {
        "id": "cursorSnap",
        "label": "Gentle attraction to UI targets",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorSnap"
        ],
        "restart": "none",
        "group": "Controller feel",
        "description": "Pulls toward the center of a nearby hovered EVE control while moving the cursor slowly. Strong stick movement escapes it. Does not snap in empty space or during drags."
      },
      {
        "id": "snapRadius",
        "label": "Attraction radius (pixels)",
        "type": "integer",
        "default": 28,
        "file": "preferences",
        "key": [
          "snapRadius"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 8,
        "maximum": 64,
        "step": 1,
        "advanced": true
      },
      {
        "id": "snapMaxSpeed",
        "label": "Maximum speed for attraction (pixels/second)",
        "type": "integer",
        "default": 250,
        "file": "preferences",
        "key": [
          "snapMaxSpeed"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 50,
        "maximum": 600,
        "step": 10,
        "advanced": true
      },
      {
        "id": "clickHoldMilliseconds",
        "label": "Hold-to-click time (milliseconds)",
        "type": "integer",
        "default": 500,
        "file": "preferences",
        "key": [
          "clickHoldMilliseconds"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 200,
        "maximum": 2000,
        "step": 50,
        "description": "Every controller mouse click waits for this hold. Default 500 ms. Release early to cancel; keep holding after confirmation to drag."
      },
      {
        "id": "rightStickStopMilliseconds",
        "label": "Right-stick stop hold (milliseconds)",
        "type": "integer",
        "default": 1000,
        "file": "preferences",
        "key": [
          "rightStickStopMilliseconds"
        ],
        "restart": "none",
        "group": "Controller feel",
        "minimum": 500,
        "maximum": 3000,
        "step": 100,
        "description": "Default 1000 ms. Release a shorter right-stick press to fly toward camera center. Hold this long to stop without issuing forward flight."
      }
    ]
  }
}
