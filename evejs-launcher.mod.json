{
  "schemaVersion": 3,
  "id": "evejs-controller",
  "displayName": "EveJS Controller",
  "version": "0.1.0",
  "description": "Controller support inside the EVE client with automatic input switching, precision cursor and menu navigation, native Controller settings, camera/ship controls, combat vibration and optional DualSense USB haptics.",
  "kind": "loader",
  "supportedBackends": [
    "native",
    "docker"
  ],
  "activation": {
    "strategy": "loader_rename"
  },
  "restart": "game_server",
  "compatibility": {
    "evejsVersions": [
      "0.12.9"
    ]
  },
  "loadBefore": [
    "automining"
  ],
  "launcherApi": {
    "version": 1,
    "minLauncherVersion": "1.0.53",
    "helper": {
      "runtime": "powershell",
      "path": "launcher-helper.ps1"
    },
    "capabilities": [
      "install",
      "prepare_profile",
      "prepare_disable",
      "prepare_remove",
      "recover"
    ]
  },
  "settings": {
    "schemaVersion": 1,
    "files": [
      {
        "id": "preferences",
        "base": "mod",
        "path": "preferences.json",
        "format": "json"
      }
    ],
    "fields": [
      {
        "id": "controllerIndex",
        "label": "Controller",
        "type": "choice",
        "default": -1,
        "file": "preferences",
        "key": [
          "controllerIndex"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "choices": [
          {
            "value": -1,
            "label": "Auto-Detect"
          },
          {
            "value": 0,
            "label": "Controller 1"
          },
          {
            "value": 1,
            "label": "Controller 2"
          },
          {
            "value": 2,
            "label": "Controller 3"
          },
          {
            "value": 3,
            "label": "Controller 4"
          },
          {
            "value": 4,
            "label": "Controller 5"
          },
          {
            "value": 5,
            "label": "Controller 6"
          },
          {
            "value": 6,
            "label": "Controller 7"
          },
          {
            "value": 7,
            "label": "Controller 8"
          },
          {
            "value": 8,
            "label": "Controller 9"
          },
          {
            "value": 9,
            "label": "Controller 10"
          },
          {
            "value": 10,
            "label": "Controller 11"
          },
          {
            "value": 11,
            "label": "Controller 12"
          },
          {
            "value": 12,
            "label": "Controller 13"
          },
          {
            "value": 13,
            "label": "Controller 14"
          },
          {
            "value": 14,
            "label": "Controller 15"
          },
          {
            "value": 15,
            "label": "Controller 16"
          }
        ]
      },
      {
        "id": "controllerIcons",
        "label": "Button Icons",
        "type": "choice",
        "default": "auto",
        "file": "preferences",
        "key": [
          "controllerIcons"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "choices": [
          {
            "value": "auto",
            "label": "Auto-Detect"
          },
          {
            "value": "xbox",
            "label": "Xbox"
          },
          {
            "value": "ps4",
            "label": "PlayStation 4"
          },
          {
            "value": "ps5",
            "label": "PlayStation 5"
          },
          {
            "value": "steam",
            "label": "Steam"
          }
        ],
        "description": "Auto follows the active detected controller. Override the icon style when Steam Input or another mapper exposes it as a virtual Xbox device."
      },
      {
        "id": "deadzone",
        "label": "Stick Deadzone",
        "type": "number",
        "default": 0.2,
        "file": "preferences",
        "key": [
          "deadzone"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 0.05,
        "maximum": 0.5,
        "step": 0.01,
        "description": "A radial deadzone suppresses drift. Small left-stick movements above this point give precision control."
      },
      {
        "id": "cursorSpeed",
        "label": "Maximum Cursor Speed (px/s)",
        "type": "integer",
        "default": 1100,
        "file": "preferences",
        "key": [
          "cursorSpeed"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50,
        "description": "Finer small-stick movement and smooth acceleration apply everywhere. Full deflection reaches this speed; releasing a direction stops its movement immediately."
      },
      {
        "id": "cameraSpeed",
        "label": "Camera Pan Speed",
        "type": "integer",
        "default": 800,
        "file": "preferences",
        "key": [
          "cameraSpeed"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 100,
        "maximum": 4000,
        "step": 50
      },
      {
        "id": "cursorRing",
        "label": "Circular Cursor",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorRing"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "description": "A minimal circular cursor with animated attraction and hold-to-click feedback."
      },
      {
        "id": "cursorSnap",
        "label": "UI Attraction",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "cursorSnap"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "description": "Pulls toward nearby native UI controls and enabled context-menu items while moving slowly. Strong or sustained outward movement escapes it. Attraction pauses while clicking or dragging."
      },
      {
        "id": "snapRadius",
        "label": "Attraction Radius (px)",
        "type": "integer",
        "default": 28,
        "file": "preferences",
        "key": [
          "snapRadius"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 8,
        "maximum": 64,
        "step": 1,
        "advanced": true
      },
      {
        "id": "snapMaxSpeed",
        "label": "Attraction Speed Limit (px/s)",
        "type": "integer",
        "default": 250,
        "file": "preferences",
        "key": [
          "snapMaxSpeed"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 50,
        "maximum": 600,
        "step": 10,
        "advanced": true
      },
      {
        "id": "clickHoldMilliseconds",
        "label": "Click / Activation Hold (ms)",
        "type": "integer",
        "default": 500,
        "file": "preferences",
        "key": [
          "clickHoldMilliseconds"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 200,
        "maximum": 2000,
        "step": 50,
        "description": "Default 500 ms. Hold over a valid space target to open its radial menu; ordinary UI retains hold-to-click and drag. Neocom A selection and B cancellation use this same hold time; D-pad navigation is immediate. Release early to cancel the pending hold."
      },
      {
        "id": "rightStickStopMilliseconds",
        "label": "Stop Hold (ms)",
        "type": "integer",
        "default": 1000,
        "file": "preferences",
        "key": [
          "rightStickStopMilliseconds"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 500,
        "maximum": 3000,
        "step": 100,
        "description": "Default 1000 ms. Release a shorter right-stick press to fly toward camera center. Hold this long to stop without issuing forward flight."
      },
      {
        "id": "windowCloseHoldMilliseconds",
        "label": "Window Close Hold (ms)",
        "type": "integer",
        "default": 1000,
        "file": "preferences",
        "key": [
          "windowCloseHoldMilliseconds"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 500,
        "maximum": 3000,
        "step": 100,
        "description": "Default 1000 ms. Hold the Close Focused Window input to move to its X, then release after the timer fills to activate the native close button. Early release or interruption returns the cursor to its starting position. Neocom and radial B controls keep their own behavior."
      },
      {
        "id": "invertCameraPan",
        "label": "Invert Camera Pan",
        "type": "boolean",
        "default": false,
        "file": "preferences",
        "key": [
          "invertCameraPan"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "description": "Reverse vertical panning only. Cursor movement and zoom keep their direction."
      },
      {
        "id": "cameraZoomSpeed",
        "label": "Camera Zoom Speed",
        "type": "number",
        "default": 0.8,
        "file": "preferences",
        "key": [
          "cameraZoomSpeed"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 0.1,
        "maximum": 3,
        "step": 0.1
      },
      {
        "id": "triggerThreshold",
        "label": "Trigger Activation",
        "type": "integer",
        "default": 40,
        "file": "preferences",
        "key": [
          "triggerThreshold"
        ],
        "restart": "none",
        "group": "Controller Feel",
        "minimum": 10,
        "maximum": 240,
        "step": 5,
        "advanced": true
      },
      {
        "id": "vibrationEnabled",
        "label": "Enable Vibration",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "vibrationEnabled"
        ],
        "restart": "none",
        "group": "Vibration",
        "description": "Master toggle. Disabling stops controller feedback immediately."
      },
      {
        "id": "vibrationStrength",
        "label": "Overall Strength",
        "type": "number",
        "default": 0.65,
        "file": "preferences",
        "key": [
          "vibrationStrength"
        ],
        "restart": "none",
        "group": "Vibration",
        "minimum": 0,
        "maximum": 1,
        "step": 0.05
      },
      {
        "id": "damageVibration",
        "label": "Incoming Damage Feedback",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "damageVibration"
        ],
        "restart": "none",
        "group": "Vibration"
      },
      {
        "id": "destructionVibration",
        "label": "Ship Destruction Feedback",
        "type": "boolean",
        "default": true,
        "file": "preferences",
        "key": [
          "destructionVibration"
        ],
        "restart": "none",
        "group": "Vibration"
      },
      {
        "id": "damageVibrationStrength",
        "label": "Damage Strength",
        "type": "number",
        "default": 0.8,
        "file": "preferences",
        "key": [
          "damageVibrationStrength"
        ],
        "restart": "none",
        "group": "Vibration",
        "minimum": 0,
        "maximum": 1,
        "step": 0.05
      },
      {
        "id": "destructionVibrationStrength",
        "label": "Destruction Strength",
        "type": "number",
        "default": 1,
        "file": "preferences",
        "key": [
          "destructionVibrationStrength"
        ],
        "restart": "none",
        "group": "Vibration",
        "minimum": 0,
        "maximum": 1,
        "step": 0.05
      },
      {
        "id": "dualsenseHaptics",
        "label": "Enhanced DualSense Haptics (USB)",
        "type": "boolean",
        "default": false,
        "file": "preferences",
        "key": [
          "dualsenseHaptics"
        ],
        "restart": "none",
        "group": "Vibration",
        "description": "Connect DualSense directly via USB for detailed feedback. Uses standard vibration when enhanced output is unavailable. Physical hardware testing is pending."
      }
    ]
  }
}
